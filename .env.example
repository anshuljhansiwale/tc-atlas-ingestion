# Teamcenter
TC_MODE=mock
TC_BASE_URL=https://teamcenter.example.com
TC_USERNAME=
TC_PASSWORD=
TC_GROUP=dba
TC_ROLE=DBA

# Local IGES storage (absolute path recommended)
CAD_ROOT=./data/iges

# MongoDB Atlas
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=cad_ingestion
MONGODB_COLLECTION=parts

# Atlas Automated Embedding (Voyage) — must match atlas/vector_index.json
VECTOR_INDEX_NAME=parts_vector_index
VOYAGE_MODEL=voyage-4

# Pipeline
BATCH_SIZE=50
LOG_LEVEL=INFO
